dock_cmd() {
  ros2 action send_goal /dock irobot_create_msgs/action/Dock
}

undock_cmd() {
  ros2 action send_goal /undock irobot_create_msgs/action/Undock
}

fwd_cmd() {
  local dist="${1:-0.5}"
  local speed="${2:-0.1}"
  if [[ "$speed" == -* ]]; then
    speed="${speed#-}"
  fi
  echo "Driving forward: distance=${dist} m, speed=${speed} m/s"
  ros2 action send_goal /drive_distance irobot_create_msgs/action/DriveDistance \
    "{distance: $dist, max_translation_speed: $speed}"
}

back_cmd() {
  local dist="${1:-0.5}"
  local speed="${2:-0.1}"
  if [[ "$speed" == -* ]]; then
    speed="${speed#-}"
  fi
  echo "Driving backward: distance=${dist} m, speed=${speed} m/s"
  ros2 action send_goal /drive_distance irobot_create_msgs/action/DriveDistance \
    "{distance: -$dist, max_translation_speed: $speed}"
}

turn_cmd() {
  local deg="${1:-90}"
  local speed="${2:-1.0}"
  local rad
  need_cmd bc
  rad="$(deg_to_rad "$deg")"
  echo "Turning: degrees=${deg}, radians=${rad}, speed=${speed}"
  ros2 action send_goal /rotate_angle irobot_create_msgs/action/RotateAngle \
    "{angle: $rad, max_rotation_speed: $speed}"
}

stop_cmd() {
  ros2 topic pub --once /cmd_vel geometry_msgs/msg/TwistStamped \
    "{header: {frame_id: 'base_link'}, twist: {linear: {x: 0.0, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 0.0}}}"
}

estop_cmd() {
  case "${1:-}" in
    on)
      ros2 service call /e_stop irobot_create_msgs/srv/EStop "{e_stop_on: true}"
      ;;
    off)
      ros2 service call /e_stop irobot_create_msgs/srv/EStop "{e_stop_on: false}"
      ;;
    *)
      echo "Usage: tb4 estop on|off"
      exit 1
      ;;
  esac
}

stop_svc_cmd() {
  echo "Stopping turtlebot4 service..."
  ssh -t ubuntu@turtlebot4 'sudo systemctl stop turtlebot4.service'
}

start_svc_cmd() {
  ssh -t ubuntu@turtlebot4 'sudo systemctl start turtlebot4.service'
}

restart_cmd() {
  ssh -t ubuntu@turtlebot4 'sudo systemctl restart turtlebot4.service'
}

reboot_create3_cmd() {
  local sock="/tmp/tb4_create3_${$}.sock"
  # Use a temporary local tunnel to reach Create3 web API via turtlebot4.
  ssh -f -N -M -S "$sock" -L 8080:192.168.186.2:80 ubuntu@turtlebot4
  curl -X POST http://localhost:8080/api/reboot
  ssh -S "$sock" -O exit ubuntu@turtlebot4 >/dev/null 2>&1 || true
}

status_cmd() {
  ssh -t ubuntu@turtlebot4 'systemctl status turtlebot4.service'
}

login_cmd() {
  ssh ubuntu@turtlebot4
}

off_cmd() {
  ros2 service call /robot_power irobot_create_msgs/srv/RobotPower "{}"
}

localize_cmd() {
  local map="${1:-$HOME/turtlebot4_ws/map_101.yaml}"
  ros2 launch turtlebot4_navigation localization.launch.py map:="$map"
}

map_cmd() {
  ros2 launch turtlebot4_navigation slam.launch.py params:=/home/qd/turtlebot4_ws/src/turtlebot4/turtlebot4_navigation/config/slam.yaml
}

map_save_cmd() {
  ros2 run nav2_map_server map_saver_cli -f /home/qd/turtlebot4_ws/map_101 --ros-args -p map_subscribe_transient_local:=true -r __ns:=/
}

joystick_cmd() {
  ssh -t ubuntu@turtlebot4 'source /opt/ros/jazzy/setup.bash && source /etc/turtlebot4/setup.bash && ros2 run joy_linux joy_linux_node --ros-args --params-file ~/bin/joy_linux.yaml -r /joy:=/teleop_joy'
}

teleop_cmd() {
  ssh -t ubuntu@turtlebot4 'source /opt/ros/jazzy/setup.bash && source /etc/turtlebot4/setup.bash && ros2 run teleop_twist_joy teleop_node --ros-args --params-file ~/bin/teleop_ps4.yaml -r /joy:=/teleop_joy'
}

wait_for_tf_cmd() {
  local from_frame="$1"
  local to_frame="$2"
  local timeout_s="${3:-30}"
  local deadline=$((SECONDS + timeout_s))

  while (( SECONDS < deadline )); do
    if timeout 2 ros2 run tf2_ros tf2_echo "$from_frame" "$to_frame" 2>/dev/null | grep -q "Translation:"; then
      return 0
    fi
    sleep 1
  done

  return 1
}

nav2_cmd() {
  local params_file="$HOME/turtlebot4_ws/src/turtlebot4/turtlebot4_navigation/config/nav2.yaml"
  ros2 launch turtlebot4_navigation nav2.launch.py params_file:="$HOME/turtlebot4_ws/src/turtlebot4/turtlebot4_navigation/config/nav2.yaml"
}

# --- Onboard Nav2 (run localization + nav2 on the robot's Pi) ---------------
# Robot paths: overlay ws = ~/tb4_overlay_ws (bt plugins), config = ~/tb4_cfg.

deploy_plugins_cmd() {
  # Nav2 runs onboard the robot (Pi). It must load two custom overlay packages:
  #   - turtlebot4_bt_plugins : behavior-tree action/condition nodes
  #   - tb4_perception_layer  : semantic costmap layer + SemanticObstacle msgs
  # The perception layer is enabled in nav2.yaml and subscribes to
  # /semantic_obstacles published by the fusion node on the UserPC, so BOTH the
  # plugin .so AND the message typesupport must be built/installed on the Pi.
  local pkgs=(
    "$HOME/turtlebot4_ws/src/turtlebot4/turtlebot4_bt_plugins"
    "$HOME/turtlebot4_ws/src/tb4_perception_layer"
  )
  echo "Deploying Nav2 overlay packages to robot (bt plugins + perception layer)..."
  ssh ubuntu@turtlebot4 'mkdir -p ~/tb4_overlay_ws/src'
  local src name
  for src in "${pkgs[@]}"; do
    name="$(basename "$src")"
    echo "  -> $name"
    ssh ubuntu@turtlebot4 "rm -rf ~/tb4_overlay_ws/src/$name"
    scp -r "$src" ubuntu@turtlebot4:'~/tb4_overlay_ws/src/'
  done
  echo "Building overlay on robot (this may take a few minutes)..."
  ssh -t ubuntu@turtlebot4 'source /opt/ros/jazzy/setup.bash && cd ~/tb4_overlay_ws && colcon build --packages-select turtlebot4_bt_plugins tb4_perception_layer'
}

deploy_onboard_cmd() {
  local mode="${1:-}"
  local cfg_src="$HOME/turtlebot4_ws/src/turtlebot4/turtlebot4_navigation/config"
  local bt_src="$HOME/turtlebot4_ws/src/turtlebot4/turtlebot4_navigation/behavior_trees"
  local launch_src="$HOME/turtlebot4_ws/src/turtlebot4/turtlebot4_navigation/launch"
  local tmp_nav2="/tmp/nav2_pi.yaml"

  echo "Generating nav2_pi.yaml (rewrite BT paths to ~/tb4_cfg, disable MPPI visualize)..."
  sed -e 's#/home/qd/turtlebot4_ws/install/turtlebot4_navigation/share/turtlebot4_navigation/behavior_trees/#/home/ubuntu/tb4_cfg/behavior_trees/#g' \
      -e 's/visualize: true/visualize: false/' \
      "$cfg_src/nav2.yaml" > "$tmp_nav2"

  echo "Creating remote config dirs..."
  ssh ubuntu@turtlebot4 'mkdir -p ~/tb4_cfg/behavior_trees ~/tb4_cfg/maps'

  echo "Copying nav2_pi.yaml, localization.yaml, behavior trees, no-docking launch..."
  scp "$tmp_nav2" ubuntu@turtlebot4:'~/tb4_cfg/nav2_pi.yaml'
  scp "$cfg_src/localization.yaml" ubuntu@turtlebot4:'~/tb4_cfg/localization.yaml'
  scp "$bt_src/"*.xml ubuntu@turtlebot4:'~/tb4_cfg/behavior_trees/'
  scp "$launch_src/navigation_no_docking.launch.py" ubuntu@turtlebot4:'~/tb4_cfg/navigation_no_docking.launch.py'

  if [ "$mode" = "full" ]; then
    echo "Copying map_101..."
    scp "$HOME/turtlebot4_ws/map_101.yaml" "$HOME/turtlebot4_ws/map_101.pgm" \
      ubuntu@turtlebot4:'~/tb4_cfg/maps/'
  fi

  rm -f "$tmp_nav2"

  # nav2.yaml enables tb4_perception_layer, which onboard nav2 loads from the
  # robot overlay (~/tb4_overlay_ws). Verify it is present so the costmap does
  # not fail to bring up when 'tb4 onboard up' runs.
  echo "Verifying perception layer overlay on robot..."
  if ssh ubuntu@turtlebot4 'test -d ~/tb4_overlay_ws/install/tb4_perception_layer'; then
    echo "  OK: tb4_perception_layer is built in the robot overlay."
  else
    echo "  WARN: tb4_perception_layer is NOT built on the robot overlay."
    echo "        nav2.yaml enables perception_layer, so onboard nav2 must load it."
    echo "        Run 'tb4 deploy plugins' before 'tb4 onboard up'."
  fi

  echo
  echo "Done. Onboard Nav2 will subscribe to /semantic_obstacles."
  echo "Perception runs on the UserPC:  tb4 yolo   and   tb4 fusion"
  echo "Then start navigation onboard:  tb4 onboard up"
  echo "(RViz on the UserPC: tb4 viz)"
}

localize_onboard_cmd() {
  ssh -t ubuntu@turtlebot4 'source /opt/ros/jazzy/setup.bash && source /etc/turtlebot4/setup.bash && ros2 launch turtlebot4_navigation localization.launch.py map:="$HOME/tb4_cfg/maps/map_101.yaml" params:="$HOME/tb4_cfg/localization.yaml"'
}

nav2_onboard_cmd() {
  ssh -t ubuntu@turtlebot4 'source /opt/ros/jazzy/setup.bash && source /etc/turtlebot4/setup.bash && source "$HOME/tb4_overlay_ws/install/setup.bash" && ros2 launch "$HOME/tb4_cfg/navigation_no_docking.launch.py" params_file:="$HOME/tb4_cfg/nav2_pi.yaml"'
}

onboard_up_cmd() {
  # Single terminal: start localization (background) then nav2 (foreground) on
  # the Pi, in one SSH session. Ctrl-C tears down both via the remote trap.
  local remote_script
  remote_script="$(cat <<'REMOTE'
#!/usr/bin/env bash
source /opt/ros/jazzy/setup.bash
source /etc/turtlebot4/setup.bash
source "$HOME/tb4_overlay_ws/install/setup.bash"

LOCALIZE_PID=""
cleanup() {
  echo "[onboard up] shutting down localization + nav2..."
  [ -n "$LOCALIZE_PID" ] && kill "$LOCALIZE_PID" 2>/dev/null || true
  pkill -f "localization.launch.py" 2>/dev/null || true
  pkill -f "nav2.launch.py" 2>/dev/null || true
  pkill -f "navigation_no_docking.launch.py" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP

# Pre-flight: kill any stale localization/nav2 processes left over from a
# previously Ctrl-C'd 'tb4 onboard up'. Orphans survive when the SSH trap does
# not propagate, and a second copy of each node starves the Pi and collides on
# DDS names -> lifecycle 'get_state' timeouts and aborted bringup.
STALE_PROCS="controller_server|smoother_server|planner_server|behavior_server|bt_navigator|waypoint_follower|velocity_smoother|collision_monitor|lifecycle_manager|amcl|map_server|localization.launch.py|navigation_no_docking.launch.py|nav2.launch.py"
if pgrep -f "$STALE_PROCS" >/dev/null 2>&1; then
  echo "[onboard up] cleaning up stale localization/nav2 processes..."
  pkill -f "$STALE_PROCS" 2>/dev/null || true
  sleep 3
fi

# Disable the Create 3's motion-control reflexes (cliff/wheel-drop/backup limit)
# so Nav2 recovery (e.g. blind reverse) is not blocked by the base. Must be the
# first ros2 action so it takes effect before navigation starts.
echo "[onboard up] setting Create 3 safety_override=full..."
ros2 param set --include-hidden-nodes /_do_not_use/motion_control safety_override full \
  || echo "[onboard up] WARN: failed to set safety_override (continuing)."

echo "[onboard up] starting localization..."
ros2 launch nav2_bringup localization_launch.py \
  map:="$HOME/tb4_cfg/maps/map_101.yaml" \
  params_file:="$HOME/tb4_cfg/localization.yaml" \
  autostart:=false &
LOCALIZE_PID=$!

wait_for_lifecycle_node() {
  local node="$1"
  local waited=0
  while ! timeout 8 ros2 lifecycle get "$node" >/dev/null 2>&1; do
    waited=$((waited + 2))
    if [ "$waited" -ge 60 ]; then
      echo "[onboard up] ERROR: lifecycle node $node did not appear." >&2
      return 1
    fi
    sleep 2
  done
}

set_lifecycle_state() {
  local node="$1"
  local state="$2"
  local attempt
  for attempt in 1 2 3 4 5; do
    if timeout 20 ros2 lifecycle set "$node" "$state"; then
      return 0
    fi
    echo "[onboard up] WARN: failed to set $node -> $state (attempt $attempt/5)."
    sleep 2
  done
  echo "[onboard up] ERROR: failed to set $node -> $state." >&2
  return 1
}

wait_for_lifecycle_node /map_server || exit 1
wait_for_lifecycle_node /amcl || exit 1
set_lifecycle_state /map_server configure || exit 1
set_lifecycle_state /amcl configure || exit 1
set_lifecycle_state /map_server activate || exit 1
set_lifecycle_state /amcl activate || exit 1

# AMCL auto-localizes at the dock and publishes map->odom after it processes
# lidar scans. Nav2's global_costmap has a 60s activation timeout, so nav2 MUST
# NOT start before map->odom exists. Wait until it does.
echo
echo "==================================================================="
echo "[onboard up] Localization is active."
echo "             Waiting for map->odom transform before starting nav2..."
echo "==================================================================="
WAIT_MAX=600
SECONDS=0
next_msg=10
while true; do
  # Each fresh tf2_echo node needs several seconds to spin up, discover the
  # FastDDS server and fill its TF buffer on the Pi, so allow up to 12s per
  # attempt (a 2s timeout kills it before map->odom is ever seen even when the
  # transform exists).
  if timeout 12 ros2 run tf2_ros tf2_echo map odom 2>/dev/null | grep -q "Translation:"; then
    echo "[onboard up] map->odom TF available; starting nav2."
    break
  fi
  if [ "$SECONDS" -ge "$WAIT_MAX" ]; then
    echo "[onboard up] ERROR: map->odom not available after ${WAIT_MAX}s." >&2
    echo "[onboard up] AMCL auto-localizes at the dock; if the robot isn't" >&2
    echo "[onboard up] docked, set a 2D Pose Estimate in RViz, then rerun. Aborting." >&2
    exit 1
  fi
  if [ "$SECONDS" -ge "$next_msg" ]; then
    echo "[onboard up] still waiting for map->odom (${SECONDS}s)..."
    next_msg=$((SECONDS + 10))
  fi
  sleep 1
done

ros2 launch "$HOME/tb4_cfg/navigation_no_docking.launch.py" \
  params_file:="$HOME/tb4_cfg/nav2_pi.yaml"
REMOTE
)"

  printf '%s\n' "$remote_script" | ssh ubuntu@turtlebot4 'cat > /tmp/tb4_onboard_up.sh'
  ssh -t ubuntu@turtlebot4 'bash /tmp/tb4_onboard_up.sh'
}

onboard_down_cmd() {
  # Kill any localization/nav2 processes on the robot. Use this to clean up
  # after a Ctrl-C'd 'tb4 onboard up' that left orphaned nodes behind.
  local stale_procs="controller_server|smoother_server|planner_server|behavior_server|bt_navigator|waypoint_follower|velocity_smoother|collision_monitor|lifecycle_manager|amcl|map_server|localization.launch.py|navigation_no_docking.launch.py|nav2.launch.py"
  echo "Stopping onboard localization + nav2 on the robot..."
  ssh ubuntu@turtlebot4 "pkill -f '$stale_procs' 2>/dev/null; sleep 2; \
    source /opt/ros/jazzy/setup.bash 2>/dev/null; \
    echo '--- remaining ROS nodes ---'; ros2 node list 2>/dev/null || true"
  echo "Done."
}

onboard_logs_cmd() {
  # Read the nav2/localization launch logs on the Pi (~/.ros/log).
  #   tb4 onboard logs            follow the newest launch's launch.log
  #   tb4 onboard logs errors     follow it, filtered to WARN|ERROR
  #   tb4 onboard logs list       list recent launch directories
  #   tb4 onboard logs <node>     follow it, filtered to a node (e.g. controller_server)
  local sub="${1:-}"
  # Newest launch dir on the Pi; 'latest' symlink is a reliable shortcut.
  local newest='D="$HOME/.ros/log/latest"; [ -d "$D" ] || D="$(ls -dt "$HOME"/.ros/log/*/ 2>/dev/null | head -1)"'
  case "$sub" in
    list)
      ssh ubuntu@turtlebot4 'ls -dt "$HOME"/.ros/log/*/ 2>/dev/null | head -20'
      ;;
    errors|error|--errors)
      echo "Following newest launch.log (WARN|ERROR) on the robot — Ctrl-C to stop."
      ssh -t ubuntu@turtlebot4 "$newest; tail -n 200 -f \"\$D/launch.log\" | grep --line-buffered -E 'WARN|ERROR|Aborting|collision|progress'"
      ;;
    "")
      echo "Following newest launch.log on the robot — Ctrl-C to stop."
      ssh -t ubuntu@turtlebot4 "$newest; tail -n 200 -f \"\$D/launch.log\""
      ;;
    *)
      echo "Following newest launch.log filtered to '$sub' — Ctrl-C to stop."
      ssh -t ubuntu@turtlebot4 "$newest; tail -n 500 -f \"\$D/launch.log\" | grep --line-buffered -F '$sub'"
      ;;
  esac
}


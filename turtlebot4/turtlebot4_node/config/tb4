yolo_cmd() {
  if [ "${1:-}" = "viz" ]; then
    ros2 launch tb4_perception yolo_detector.launch.py publish_visualisation:=true
  else
    ros2 launch tb4_perception yolo_detector.launch.py publish_visualisation:=false
  fi
}

fusion_cmd() {
  local params_file="$HOME/turtlebot4_ws/src/tb4_perception_integration/config/fusion_params.yaml"
  if [ "${1:-}" = "viz" ]; then
    ros2 launch tb4_perception_integration perception_integration.launch.py params_file:="$params_file" publish_debug_markers:=true
  else
    ros2 launch tb4_perception_integration perception_integration.launch.py params_file:="$params_file"
  fi
}

bbox_cmd() {
  # Start the YOLO detector node and the camera-LiDAR fusion node together.
  #   tb4 bbox                          -> both nodes, no visualisation
  #   tb4 bbox viz                      -> both nodes with visualisation/debug markers
  #   tb4 bbox yolo-viz                 -> only YOLO visualisation enabled
  #   tb4 bbox fusion-viz               -> only fusion debug markers enabled
  #   tb4 bbox yolo-viz fusion-viz      -> same as 'viz'
  local yolo_arg="" fusion_arg=""
  for arg in "$@"; do
    case "$arg" in
      viz)         yolo_arg="viz"; fusion_arg="viz" ;;
      yolo-viz)    yolo_arg="viz" ;;
      fusion-viz)  fusion_arg="viz" ;;
      *)
        echo "Unknown bbox option: '$arg' (use: viz | yolo-viz | fusion-viz)"
        exit 1
        ;;
    esac
  done

  local pids=()
  cleanup() {
    kill "${pids[@]}" 2>/dev/null || true
    wait "${pids[@]}" 2>/dev/null || true
  }
  trap cleanup INT TERM EXIT

  yolo_cmd "$yolo_arg" &
  pids+=("$!")

  fusion_cmd "$fusion_arg" &
  pids+=("$!")

  # Exit as soon as either node stops, then clean up the other.
  wait -n "${pids[@]}"
}

